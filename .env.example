# LLM backend: claude_code (uses your logged-in Claude Code / Pro) or ollama
LLM_BACKEND=claude_code
MAIN_MODEL=sonnet
CHECK_MODEL=haiku
# Only used when LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
# Second opinion: also review the neutral view with CHECK_MODEL (1 extra call per batch)
REVIEW_ENSEMBLE=0
# Logs on stderr: debug | info | warning | error, and text | json
AGENTSENTINEL_LOG_LEVEL=warning
AGENTSENTINEL_LOG_FORMAT=text
# Every setting is validated at start; check yours with: python -m core.config
